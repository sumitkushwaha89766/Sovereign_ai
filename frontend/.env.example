# Frontend runtime config (Vite). All values are LOCAL — no external hosts (sovereignty).
# Backend base URL — Architecture §4.1 mandates localhost-only.
VITE_API_BASE=http://localhost:8000

# Data mode:
#   true  = mock/static data. Phase 5 default; runs with no backend.
#   false = live axios calls to the Phase 4 backend. Use for Phase 6.
VITE_USE_MOCKS=false
